<!-- WinUI 3 demo app hosting SlintPanel. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- Unpackaged for the spike; MSIX packaging is M6. -->
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- Loaded at run time through sb_compile; one file shared with the Rust tests and the Swift demo. -->
    <None Include="..\..\crates\slint-bindings-core\ui\demo.slint" Link="demo.slint" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SlintBindings.WinUI\SlintBindings.WinUI.csproj" />
  </ItemGroup>
</Project>
