import { Button, HorizontalBox, LineEdit, Palette, VerticalBox } from "std-widgets.slint";

export component LoginScreen inherits Window {
    title: "Sign in";
    in-out property <string> email;
    in-out property <string> password;
    callback perform(string, string);

    login := VerticalBox {
        alignment: LayoutAlignment.start;
        form := VerticalBox {
            title := Text {
                text: "Sign in";
                font-size: 32px;
                font-weight: 700;
            }
            fields := VerticalLayout {
                alignment: LayoutAlignment.start;
                spacing: 16px;
                VerticalLayout {
                    vertical-stretch: 0;
                    Text { text: "Email"; }
                    email := LineEdit {
                        text <=> root.email;
                        accepted => { root.perform("auth.submit", "form"); }
                    }
                }
                VerticalLayout {
                    vertical-stretch: 0;
                    Text { text: "Password"; }
                    password := LineEdit {
                        input-type: InputType.password;
                        text <=> root.password;
                        accepted => { root.perform("auth.submit", "form"); }
                    }
                }
            }
            submit := Button {
                text: "Sign in";
                primary: true;
                enabled: root.email != "";
                clicked => { root.perform("auth.submit", "form"); }
            }
            HorizontalBox {
                reset := TouchArea {
                    clicked => { root.perform("nav.reset", "reset"); }
                    Text { text: "Forgot password?"; color: Palette.accent-background; }
                }
                signup := TouchArea {
                    clicked => { root.perform("nav.signup", "signup"); }
                    Text { text: "Create an account"; color: Palette.accent-background; }
                }
            }
        }
    }
}
