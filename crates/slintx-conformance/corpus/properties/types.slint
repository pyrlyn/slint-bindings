// property-types: every primitive property type.
export component Main inherits Window {
    property <int> i; property <float> f; property <bool> b; property <string> s;
    property <color> c; property <brush> br; property <physical-length> pl;
    property <length> l; property <duration> d; property <angle> a; property <easing> e;
    property <percent> p; property <image> img; property <relative-font-size> r;
    property <[int]> arr; property <{a: int, b: string}> st;
}
