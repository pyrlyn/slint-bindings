// language/states-and-transitions: a property with its own `animate` and a transition animate.
// OPEN O53: state change against the property's own animation.
export component Main inherits Window {
    in property <bool> active;
    r := Rectangle {
        animate x { duration: 50ms; }
    }
    states [
        on when active: { r.x: 10px; in { animate r.x { duration: 100ms; } } }
    ]
}
