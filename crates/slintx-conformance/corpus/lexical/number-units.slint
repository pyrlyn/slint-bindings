// property-types/numeric-types: unit suffixes are part of the number.
export component Main inherits Window {
    property <length> l: 10px + 2phx + 1cm + 1mm + 1in + 1pt;
    property <duration> d: 1.5s + 20ms;
    property <percent> p: 50%;
    property <angle> a: 0.5turn + 1rad + 90deg;
    property <relative-font-size> r: 1.5rem;
}
