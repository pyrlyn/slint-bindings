// language/name-resolution: `self`, `parent` and `root` inside `for` and `if`.
// OPEN O32: resolution inside repeated elements.
export component Main inherits Window {
    property <bool> show: true;
    for i in 3: Rectangle {
        width: parent.width / 3;
        height: root.height;
        x: self.width * i;
    }
    if show: Rectangle { width: parent.width; }
}
