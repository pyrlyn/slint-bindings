---
source: crates/slintx-convert/tests/snapshots.rs
expression: "render(name, format, options)"
---
using Gtk 4.0;

// Converted from repeat_if.slint by slint-convert.
// Interface of RepeatIf:
//   in property <[string]> names = [Ann, Bob]
//   in property <bool> show-footer = true

Gtk.Window {
  Gtk.Box {
    orientation: vertical;
    // for name[index] in root.names: template, emitted once
    // binding text : "\{index}: \{name}"
    Gtk.Label {
      vexpand: true;
      xalign: 0;
      yalign: 0;
    }
    // if root.show-footer
    Gtk.Label {
      label: "Footer";
      vexpand: true;
      xalign: 0;
      yalign: 0;
    }
  }
}
