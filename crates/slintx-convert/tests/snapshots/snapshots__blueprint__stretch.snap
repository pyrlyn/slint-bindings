using Gtk 4.0;

// Converted from stretch.slint by slint-convert.

Gtk.Window {
  default-width: 400;
  default-height: 120;
  Gtk.Box {
    orientation: vertical;
    Gtk.Box {
      vexpand: true;
      orientation: horizontal;
      Gtk.Box {
        hexpand: true;
      }
      Gtk.Box {
        hexpand: true;
      }
      Gtk.Box {
        width-request: 40;
      }
    }
    Gtk.Box {
      vexpand: true;
      orientation: horizontal;
      halign: center;
      Gtk.Box {
      }
      Gtk.Box {
      }
    }
    Gtk.Overlay {
      vexpand: true;
      [overlay] Gtk.Box {
        width-request: 20;
        height-request: 20;
        halign: start;
        margin-start: 10;
        valign: start;
        margin-top: 4;
      }
    }
  }
}

