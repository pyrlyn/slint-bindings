<?xml version="1.0" encoding="UTF-8"?>
<slint file="stretch.slint">
  <component name="Stretch" base="Window" exported="true" at="2:8"/>
  <Window component="Stretch" at="2:8">
    <size axis="width" fixed="400px"/>
    <size axis="height" fixed="120px"/>
    <VerticalLayout at="6:5">
      <layout kind="vertical"/>
      <HorizontalLayout at="7:9">
        <layout kind="horizontal"/>
        <Rectangle at="8:13">
          <size axis="width" stretch="1"/>
          <property name="background" kind="color" value="red" at="8:48"/>
        </Rectangle>
        <Rectangle at="9:13">
          <size axis="width" stretch="2"/>
          <property name="background" kind="color" value="green" at="9:48"/>
        </Rectangle>
        <Rectangle at="10:13">
