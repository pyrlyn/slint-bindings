        </Rectangle>
      </HorizontalLayout>
      <Rectangle at="17:9">
        <Rectangle at="18:13">
          <size axis="width" fixed="20px"/>
          <size axis="height" fixed="20px"/>
          <position x="10px" y="4px"/>
          <property name="background" kind="color" value="black" at="18:69"/>
        </Rectangle>
      </Rectangle>
    </VerticalLayout>
  </Window>
</slint>
