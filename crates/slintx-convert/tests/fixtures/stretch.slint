// Stretch factors, size limits and leftover-space alignment.
export component Stretch inherits Window {
    width: 400px;
    height: 120px;

    VerticalLayout {
        HorizontalLayout {
            Rectangle { horizontal-stretch: 1; background: red; }
            Rectangle { horizontal-stretch: 2; background: green; }
            Rectangle { horizontal-stretch: 0; min-width: 40px; background: blue; }
        }
        HorizontalLayout {
            alignment: center;
            Rectangle { preferred-width: 50px; max-width: 80px; background: #336699; }
            Rectangle { preferred-width: 50px; vertical-stretch: 0; background: #996633; }
        }
        Rectangle {
            Rectangle { x: 10px; y: 4px; width: 20px; height: 20px; background: black; }
        }
    }
}
